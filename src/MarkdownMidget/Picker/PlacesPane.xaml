<UserControl x:Class="MarkdownMidget.Picker.PlacesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:chrome="clr-namespace:MarkdownMidget.Chrome">
    <UserControl.Resources>
        <!-- A section: a card with a larger header and its entries indented below; the entries keep the theme's look. -->
        <Style x:Key="PlacesSection" TargetType="{x:Type TreeViewItem}">
            <Setter Property="Margin" Value="3,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <!-- The card is a layer underneath that takes no clicks: its blank space is the pane's, as in 1.0.2 and earlier.
                                 Tag holds whether high contrast is on, kept current by DynamicResource. -->
                            <Border x:Name="Card" CornerRadius="4" BorderThickness="1" IsHitTestVisible="False"
                                    Background="{DynamicResource {x:Static chrome:ChromeKeys.PickerSectionBackground}}"
                                    BorderBrush="{DynamicResource {x:Static chrome:ChromeKeys.PickerSectionBorder}}"
                                    Tag="{DynamicResource {x:Static SystemParameters.HighContrastKey}}">
                                <!-- The header's shaded band: the card's full width, the header's height, inside its rounded top corners. -->
                                <Border x:Name="Strip" VerticalAlignment="Top" CornerRadius="3,3,0,0" Height="{Binding ActualHeight, ElementName=PART_Header}"
                                        Background="{DynamicResource {x:Static chrome:ChromeKeys.PickerSectionHeader}}" />
                            </Border>
                            <StackPanel Margin="1,1,1,4">
                                <!-- The 1px edge shows only on a selected header while the tree hasn't the focus, whose fill is as pale as the band. -->
                                <Border x:Name="PART_Header" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"
                                        Padding="3,3,7,3" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Chevron" Text="&#xE70D;" Width="16" FontSize="10" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                        <ContentPresenter ContentSource="Header" TextElement.FontSize="14" TextElement.FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                            </Trigger>
                            <!-- Selected is the keyboard's place, as on the theme's own items. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Header" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="PART_Header" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PART_Header" Property="Background" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
                                <Setter TargetName="PART_Header" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}}" />
                                <Setter TargetName="PART_Header" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                            </MultiTrigger>
                            <!-- High contrast takes the light palette, whose shading would sit under the system's text colours:
                                 there the card is the system's window colour with a window-text edge, and the band its control colour. -->
                            <Trigger SourceName="Card" Property="Tag">
                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter TargetName="Strip" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged" PreviewKeyDown="Tree_PreviewKeyDown"
              TreeViewItem.Expanded="Tree_ExpandedOrCollapsed" TreeViewItem.Collapsed="Tree_ExpandedOrCollapsed" />
</UserControl>
