<Window x:Class="MarkdownMidget.Picker.PickerOfferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markdown Midget" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/midget-256.png">
    <!-- The one-time offer of Windows' dialog (#12, item 6). The chrome palette and dialog
         placement reach it as every window: no code here. Esc and the close box mean Keep. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="QuestionText" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Use Windows' dialog" IsDefault="True" Padding="10,3" Margin="0,0,8,0" Click="UseWindows_Click" />
            <Button Content="_Keep the built-in picker" IsCancel="True" Padding="10,3" />
        </StackPanel>
    </StackPanel>
</Window>
