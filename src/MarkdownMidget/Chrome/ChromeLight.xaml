<!-- The chrome palette for light mode: the colours the app draws today, so switching
     back from dark changes nothing. ChromeDark.xaml defines the same keys (a test holds
     the two to one key set). What each group paints:
       System       stand in for SystemColors keys in dark mode (ChromePalette.SystemColorTokens);
                    the light values are the Windows defaults and are never merged over the
                    real system colours, so high contrast keeps working.
       Menu..Combo  brushes the dark templates in ChromeStyles.xaml use; the light values are
                    the ones Aero2 hard-codes, so those templates with this palette draw Aero2
                    pixel for pixel (ChromeRenderTests).
       Windows      colours that were written straight into the windows' XAML. -->
<ResourceDictionary x:Class="MarkdownMidget.Chrome.ChromeLightPalette"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- System -->
    <SolidColorBrush x:Key="Chrome.Window.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Chrome.Window.Frame" Color="#FF646464" />
    <SolidColorBrush x:Key="Chrome.Text" Color="#FF000000" />
    <SolidColorBrush x:Key="Chrome.Text.Disabled" Color="#FF6D6D6D" />
    <SolidColorBrush x:Key="Chrome.Control.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Chrome.Control.Dark" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Chrome.Control.DarkDark" Color="#FF696969" />
    <SolidColorBrush x:Key="Chrome.Selection.Background" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Chrome.Selection.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Chrome.Selection.Inactive.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Chrome.Link" Color="#FF0066CC" />

    <!-- Menu, context menu -->
    <SolidColorBrush x:Key="Chrome.Menu.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Chrome.Menu.Text" Color="#FF212121" />
    <SolidColorBrush x:Key="Chrome.Menu.Text.Disabled" Color="#FF707070" />
    <SolidColorBrush x:Key="Chrome.Menu.Popup.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Chrome.Menu.Popup.Border" Color="#FF999999" />
    <SolidColorBrush x:Key="Chrome.Menu.Separator" Color="#FFD7D7D7" />
    <SolidColorBrush x:Key="Chrome.Menu.Highlight.Background" Color="#3D26A0DA" />
    <SolidColorBrush x:Key="Chrome.Menu.Highlight.Border" Color="#FF26A0DA" />
    <SolidColorBrush x:Key="Chrome.Menu.DisabledHighlight.Background" Color="#0A000000" />
    <SolidColorBrush x:Key="Chrome.Menu.DisabledHighlight.Border" Color="#21000000" />
    <SolidColorBrush x:Key="Chrome.ContextMenu.Background" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="Chrome.ContextMenu.Border" Color="#FF959595" />
    <SolidColorBrush x:Key="Chrome.ContextMenu.Gutter" Color="#FFF1F1F1" />
    <SolidColorBrush x:Key="Chrome.ContextMenu.GutterLine" Color="#FFE2E3E3" />
    <!-- The white half of Aero2's etched lines (menu gutter, group box, toolbar glyphs). -->
    <SolidColorBrush x:Key="Chrome.Etched.Highlight" Color="#FFFFFFFF" />

    <!-- Menu separators: Aero2 draws them with 2px above and below, but only on a separator whose
         style has never changed (a WPF quirk); once dark mode has restyled one it would lose
         them. Setting the margin here keeps every separator as it looked before, in both modes.
         Margin only in light, so the theme (high contrast included) still colours it. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <!-- Toolbar, status bar, tooltip -->
    <SolidColorBrush x:Key="Chrome.ToolBar.Background" Color="#FFEEF5FD" />
    <SolidColorBrush x:Key="Chrome.ToolBar.Separator" Color="#FFB6BDC5" />
    <SolidColorBrush x:Key="Chrome.StatusBar.Background" Color="#FFF1EDED" />
    <SolidColorBrush x:Key="Chrome.ToolTip.Background" Color="#FFF1F2F7" />
    <SolidColorBrush x:Key="Chrome.ToolTip.Border" Color="#FF767676" />
    <SolidColorBrush x:Key="Chrome.ToolTip.Text" Color="#FF575757" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="Chrome.Button.Background" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Chrome.Button.Border" Color="#FF707070" />
    <SolidColorBrush x:Key="Chrome.Button.Hover.Background" Color="#FFBEE6FD" />
    <SolidColorBrush x:Key="Chrome.Button.Hover.Border" Color="#FF3C7FB1" />
    <SolidColorBrush x:Key="Chrome.Button.Pressed.Background" Color="#FFC4E5F6" />
    <SolidColorBrush x:Key="Chrome.Button.Pressed.Border" Color="#FF2C628B" />
    <SolidColorBrush x:Key="Chrome.Button.Checked.Background" Color="#FFBCDDEE" />
    <SolidColorBrush x:Key="Chrome.Button.Checked.Border" Color="#FF245A83" />
    <SolidColorBrush x:Key="Chrome.Button.Disabled.Background" Color="#FFF4F4F4" />
    <SolidColorBrush x:Key="Chrome.Button.Disabled.Border" Color="#FFADB2B5" />
    <SolidColorBrush x:Key="Chrome.Button.Disabled.Text" Color="#FF838383" />

    <!-- Fields, lists, check marks, group box, progress -->
    <SolidColorBrush x:Key="Chrome.Field.Border" Color="#FFABADB3" />
    <SolidColorBrush x:Key="Chrome.List.Border" Color="#FF828790" />
    <SolidColorBrush x:Key="Chrome.Check.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Chrome.Check.Border" Color="#FF707070" />
    <SolidColorBrush x:Key="Chrome.Check.Glyph" Color="#FF212121" />
    <SolidColorBrush x:Key="Chrome.Check.Hover.Background" Color="#FFF3F9FF" />
    <SolidColorBrush x:Key="Chrome.Check.Hover.Border" Color="#FF5593FF" />
    <SolidColorBrush x:Key="Chrome.Check.Pressed.Background" Color="#FFD9ECFF" />
    <SolidColorBrush x:Key="Chrome.Check.Pressed.Border" Color="#FF3C77DD" />
    <SolidColorBrush x:Key="Chrome.Check.Disabled.Background" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="Chrome.Check.Disabled.Border" Color="#FFBCBCBC" />
    <SolidColorBrush x:Key="Chrome.Check.Disabled.Glyph" Color="#FF707070" />
    <SolidColorBrush x:Key="Chrome.GroupBox.Border" Color="#FFD5DFE5" />
    <SolidColorBrush x:Key="Chrome.Progress.Background" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="Chrome.Progress.Border" Color="#FFBCBCBC" />
    <SolidColorBrush x:Key="Chrome.Progress.Foreground" Color="#FF06B025" />

    <!-- Scroll bars -->
    <SolidColorBrush x:Key="Chrome.ScrollBar.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Button.Hover" Color="#FFDADADA" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Button.Pressed" Color="#FF606060" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Glyph" Color="#FF606060" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Glyph.Hover" Color="#FF000000" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Glyph.Pressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Glyph.Disabled" Color="#FFBFBFBF" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Thumb" Color="#FFCDCDCD" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Thumb.Hover" Color="#FFA6A6A6" />
    <SolidColorBrush x:Key="Chrome.ScrollBar.Thumb.Dragging" Color="#FF606060" />

    <!-- Combo box -->
    <LinearGradientBrush x:Key="Chrome.ComboBox.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF0F0F0" Offset="0" /><GradientStop Color="#FFE5E5E5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Chrome.ComboBox.Border" Color="#FFACACAC" />
    <LinearGradientBrush x:Key="Chrome.ComboBox.Hover.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFECF4FC" Offset="0" /><GradientStop Color="#FFDCECFC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Chrome.ComboBox.Hover.Border" Color="#FF7EB4EA" />
    <LinearGradientBrush x:Key="Chrome.ComboBox.Pressed.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFDAECFC" Offset="0" /><GradientStop Color="#FFC4E0FC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Chrome.ComboBox.Pressed.Border" Color="#FF569DE5" />
    <SolidColorBrush x:Key="Chrome.ComboBox.Disabled.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Chrome.ComboBox.Disabled.Border" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="Chrome.ComboBox.Arrow" Color="#FF606060" />
    <SolidColorBrush x:Key="Chrome.ComboBox.Arrow.Active" Color="#FF000000" />
    <SolidColorBrush x:Key="Chrome.ComboBox.Arrow.Disabled" Color="#FFBFBFBF" />

    <!-- Windows: colours the windows' XAML used to spell out -->
    <SolidColorBrush x:Key="Chrome.Text.Accent" Color="#FF3B6EA5" />
    <SolidColorBrush x:Key="Chrome.Text.Secondary" Color="#FF5B6570" />
    <SolidColorBrush x:Key="Chrome.Busy.Veil" Color="#A0FFFFFF" />
    <SolidColorBrush x:Key="Chrome.Splash.Background" Color="#FF707479" />
    <SolidColorBrush x:Key="Chrome.Find.Status.Background" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="Chrome.Find.Status.Border" Color="#FFC8CCD4" />
    <SolidColorBrush x:Key="Chrome.Dialog.PathText" Color="#FF444444" />
    <SolidColorBrush x:Key="Chrome.Dialog.MutedText" Color="#FF555555" />
    <SolidColorBrush x:Key="Chrome.Dialog.CodeText" Color="#FF666666" />
    <SolidColorBrush x:Key="Chrome.Dialog.HintText" Color="#FF777777" />
    <SolidColorBrush x:Key="Chrome.Dialog.FaintText" Color="#FF808080" />
    <SolidColorBrush x:Key="Chrome.Dialog.WarningText" Color="#FFB7500F" />
    <SolidColorBrush x:Key="Chrome.Dialog.ErrorText" Color="#FFB00020" />
    <SolidColorBrush x:Key="Chrome.Dialog.InvalidText" Color="#FFB22222" />
    <SolidColorBrush x:Key="Chrome.Chip.Background" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="Chrome.Chip.Border" Color="#FFCFD4DB" />
    <SolidColorBrush x:Key="Chrome.Chip.Text" Color="#FF3A3F46" />
    <SolidColorBrush x:Key="Chrome.Chip.ArrowText" Color="#FF8A9099" />
    <SolidColorBrush x:Key="Chrome.Chip.CaptionText" Color="#FF5B6168" />
    <SolidColorBrush x:Key="Chrome.Chip.RemovedText" Color="#FFB23A3A" />
    <!-- Toolbar pictures drawn in near-black: a light copy replaces each in dark mode. -->
    <BitmapImage x:Key="Chrome.Icon.NumberedList" UriSource="pack://application:,,,/MarkdownMidget;component/Assets/numbered-list-64.png" />
    <BitmapImage x:Key="Chrome.Icon.SpellCheck" UriSource="pack://application:,,,/MarkdownMidget;component/Assets/spellcheck-64.png" />
</ResourceDictionary>
