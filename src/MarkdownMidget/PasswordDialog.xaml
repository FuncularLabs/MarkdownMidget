<Window x:Class="MarkdownMidget.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Icon="/Assets/midget-256.png">
    <StackPanel Margin="16">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock x:Name="WarningBlock" TextWrapping="Wrap" Margin="0,0,0,12"
                   FontWeight="SemiBold" Foreground="#B7500F"
                   Text="There is no way to recover this document if you forget the password. Not by us, not by anyone. Write it down somewhere safe." />
        <TextBlock x:Name="ErrorBlock" TextWrapping="Wrap" Margin="0,0,0,12"
                   FontWeight="SemiBold" Foreground="#B00020" Visibility="Collapsed" />
        <TextBlock x:Name="Label1" Text="Password" Margin="0,0,0,4" />
        <PasswordBox x:Name="Box1" Margin="0,0,0,4" Padding="3" PasswordChanged="Box_Changed" />
        <TextBlock x:Name="StrengthText" Margin="0,0,0,8" FontSize="11" Foreground="Gray" Text="" />
        <TextBlock x:Name="Label2" Text="Confirm password" Margin="0,0,0,4" />
        <PasswordBox x:Name="Box2" Margin="0,0,0,4" Padding="3" PasswordChanged="Box_Changed" />
        <TextBlock x:Name="MatchText" Margin="0,0,0,12" FontSize="11" Foreground="Gray" Text="" />
        <Grid>
            <Button x:Name="DiscardButton" Content="_Discard Copy…" Width="110"
                    HorizontalAlignment="Left" Visibility="Collapsed" Click="Discard_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="OK" IsDefault="True" Width="80" Margin="0,0,8,0"
                        Click="Ok_Click" IsEnabled="False" />
                <Button Content="Cancel" IsCancel="True" Width="80" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
