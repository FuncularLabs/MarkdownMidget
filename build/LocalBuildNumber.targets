<Project>
  <!--
    A number for every local build, so a freshly published MarkdownMidget.exe can be told
    apart from the one it replaced: FileVersion 0.11.0 -> 0.11.0.57, InformationalVersion
    0.11.0-dev -> 0.11.0-dev+build.57. Imported by src/MarkdownMidget only.

    Every build takes the next number, even one where nothing changed - that is what makes
    a fresh publish identifiable - and the changed attribute costs a recompile, about a
    second. The counter belongs to the REPOSITORY, not the checkout, so a clone and every
    worktree linked to it share one sequence and no number is issued twice. README's
    "Build & run" covers resetting it, turning it off, and the warnings.
  -->

  <PropertyGroup>
    <!-- Used only when there is no .git to read: then the checkout is all there is. -->
    <LocalBuildNumberFallbackFile Condition="'$(LocalBuildNumberFallbackFile)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..', '.local-build-number'))</LocalBuildNumberFallbackFile>
    <!-- CI keeps today's version strings exactly: release.yml passes -p:Version and
         -p:InformationalVersion from the tag. CI=false is a real value meaning "not CI". -->
    <UseLocalBuildNumber Condition="'$(UseLocalBuildNumber)' == '' and ('$(GITHUB_ACTIONS)' != '' or ('$(CI)' != '' and '$(CI)' != 'false') or '$(TF_BUILD)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true')">false</UseLocalBuildNumber>
    <!-- A design-time build compiles nothing, and WPF's markup compiler builds a second,
         temporary copy of this project named <project>_<random>_wpftmp (see
         GenerateTemporaryTargetAssembly): a number spent in either is one no binary
         carries, and the count would advance twice per build. -->
    <UseLocalBuildNumber Condition="'$(UseLocalBuildNumber)' == '' and ('$(DesignTimeBuild)' == 'true' or '$(BuildingProject)' == 'false' or $(MSBuildProjectName.EndsWith('_wpftmp')))">false</UseLocalBuildNumber>
    <UseLocalBuildNumber Condition="'$(UseLocalBuildNumber)' == ''">true</UseLocalBuildNumber>
  </PropertyGroup>

  <!--
    Take the next number. The lock is opened DeleteOnClose, so a killed build leaves nothing
    for the next one to wait on, and the counter is replaced rather than overwritten, so a
    half-written number cannot be read back. Any failure - held, corrupt, at a file version's
    ceiling, unwritable - warns once and leaves the build reporting what it did before this
    feature existed; inventing a number would reuse an older exe's.
  -->
  <UsingTask TaskName="AllocateLocalBuildNumber" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CounterFile ParameterType="System.String" Required="true" />
      <BaseFileVersion ParameterType="System.String" />
      <BaseInformationalVersion ParameterType="System.String" />
      <Number ParameterType="System.Int32" Output="true" />
      <FileVersion ParameterType="System.String" Output="true" />
      <InformationalVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.Threading" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Number = 0; FileVersion = BaseFileVersion; InformationalVersion = BaseInformationalVersion;
        string problem = null;
        try
        {
            Directory.CreateDirectory(Path.GetDirectoryName(CounterFile));
            FileStream held = null;
            // A critical section here is a millisecond, so two seconds is room for a
            // hundred builds at once; longer than that is not contention.
            DateTime deadline = DateTime.UtcNow.AddSeconds(2);
            while (held == null)
                try
                {
                    held = new FileStream(CounterFile + ".lock", FileMode.OpenOrCreate, FileAccess.ReadWrite,
                                          FileShare.None, 1, FileOptions.DeleteOnClose);
                }
                catch (Exception ex)
                {
                    if (DateTime.UtcNow >= deadline) { problem = ex.GetType().Name + ": " + ex.Message; break; }
                    Thread.Sleep(20);
                }
            if (held != null)
                using (held)
                {
                    string text = File.Exists(CounterFile) ? File.ReadAllText(CounterFile).Trim() : "0";
                    int current;   // 65534 is the highest a file-version component can hold
                    if (!int.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out current) || current >= 65534)
                        problem = CounterFile + " holds \"" + text + "\" - delete it to start again at 1";
                    else
                    {
                        string staging = CounterFile + ".tmp";
                        File.WriteAllText(staging, (current + 1).ToString(CultureInfo.InvariantCulture));
                        if (File.Exists(CounterFile)) File.Replace(staging, CounterFile, null);
                        else File.Move(staging, CounterFile);
                        Number = current + 1;
                    }
                }
        }
        catch (Exception ex) { problem = ex.GetType().Name + ": " + ex.Message; Number = 0; }
        if (Number == 0)
            Log.LogWarning(null, "MMBN0001", null, null, 0, 0, 0, 0,
                "This build carries no local build number: {0}.", problem ?? "the counter could not be read");
        else
        {
            Version parsed;   // the fourth component is the one this project does not use
            if (Version.TryParse(BaseFileVersion, out parsed))
                FileVersion = string.Format(CultureInfo.InvariantCulture, "{0}.{1}.{2}.{3}", parsed.Major,
                    Math.Max(parsed.Minor, 0), Math.Max(parsed.Build, 0), Number);
            // SemVer build metadata takes no part in precedence, so the update check reads
            // a numbered build as the version it says it is. One '+' only: if the SDK has
            // already appended a commit sha, join this to it with a dot.
            InformationalVersion = BaseInformationalVersion +
                (BaseInformationalVersion.IndexOf('+') >= 0 ? "." : "+") + "build." + Number;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Hooked on GetAssemblyAttributes: where the SDK turns these two properties into the
    attributes it generates, before every compile of this project, `dotnet publish` included
    (GetAssemblyVersion fills them in first).

    Finding the repository is file reads, not a `git` call - no process to hang, nothing that
    has to be on PATH - and it is the derivation git does: .git is the repository directory,
    or a file reading "gitdir: <path>" relative to the checkout, and a worktree's gitdir
    holds `commondir` naming the directory the whole repository shares. Anything else falls
    back to the checkout's own counter and WARNS, because two checkouts counting separately
    is how one number lands on two binaries.
  -->
  <Target Name="SetLocalBuildNumber" BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="GetAssemblyVersion" Condition="'$(UseLocalBuildNumber)' == 'true'">
    <PropertyGroup>
      <_LbnCheckout>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</_LbnCheckout>
      <_LbnDotGit>$(_LbnCheckout).git</_LbnDotGit>
      <_LbnGitDir Condition="$([System.IO.Directory]::Exists('$(_LbnDotGit)'))">$(_LbnDotGit)</_LbnGitDir>
      <_LbnLinkText Condition="'$(_LbnGitDir)' == '' and Exists('$(_LbnDotGit)')">$([System.IO.File]::ReadAllText('$(_LbnDotGit)').Trim())</_LbnLinkText>
      <_LbnGitDir Condition="$(_LbnLinkText.StartsWith('gitdir: '))">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_LbnCheckout)', '$(_LbnLinkText.Substring(8))'))))</_LbnGitDir>
      <_LbnCommonFile Condition="'$(_LbnGitDir)' != ''">$([System.IO.Path]::Combine('$(_LbnGitDir)', 'commondir'))</_LbnCommonFile>
      <_LbnCommon Condition="'$(_LbnCommonFile)' != '' and Exists('$(_LbnCommonFile)')">$([System.IO.File]::ReadAllText('$(_LbnCommonFile)').Trim())</_LbnCommon>
      <_LbnGitDir Condition="'$(_LbnCommon)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_LbnGitDir)', '$(_LbnCommon)'))))</_LbnGitDir>
      <!-- A commondir that exists and says nothing would otherwise leave this worktree
           counting on its own gitdir, in its own sequence, silently. -->
      <_LbnGitDir Condition="'$(_LbnCommonFile)' != '' and Exists('$(_LbnCommonFile)') and '$(_LbnCommon)' == ''" />
      <LocalBuildNumberFile Condition="'$(_LbnGitDir)' != '' and $([System.IO.Directory]::Exists('$(_LbnGitDir)'))">$([System.IO.Path]::Combine('$(_LbnGitDir)', 'mm-local-build-number'))</LocalBuildNumberFile>
      <LocalBuildNumberFile Condition="'$(LocalBuildNumberFile)' == ''">$(LocalBuildNumberFallbackFile)</LocalBuildNumberFile>
    </PropertyGroup>

    <Warning Condition="'$(LocalBuildNumberFile)' == '$(LocalBuildNumberFallbackFile)'" Code="MMBN0003"
             Text="No git repository was found at $(_LbnDotGit), so local build numbers are being counted per checkout in $(LocalBuildNumberFallbackFile). Two checkouts can then stamp one number on two different binaries." />

    <AllocateLocalBuildNumber CounterFile="$(LocalBuildNumberFile)" BaseFileVersion="$(FileVersion)"
                              BaseInformationalVersion="$(InformationalVersion)">
      <Output TaskParameter="Number" PropertyName="LocalBuildNumber" />
      <Output TaskParameter="FileVersion" PropertyName="FileVersion" />
      <Output TaskParameter="InformationalVersion" PropertyName="InformationalVersion" />
    </AllocateLocalBuildNumber>

    <Message Importance="high" Condition="'$(LocalBuildNumber)' != '0'"
             Text="$(MSBuildProjectName) local build #$(LocalBuildNumber) - $(InformationalVersion) (file version $(FileVersion))" />
  </Target>

</Project>
