# Build output
[Bb]in/
[Oo]bj/
*.user

# Test results (dotnet test's default results folder; coverage reports land here too)
TestResults/

# Node / editor bundle deps
node_modules/

# Generated editor bundle (rebuilt from editor-src via `npm run build`)
src/MarkdownMidget/wwwroot/*.map

# IDE / tooling
.vs/
*.suo
.claude/

# Release staging
dist/

# Local build counter (build/LocalBuildNumber.targets), plus its lock and staging
# files. The counter normally lives in the repository's own directory
# (.git/mm-local-build-number), which git never tracks; this is the fallback used
# when there is no git repository to ask. See README, "Build & run".
.local-build-number*

# External-change backups (created by MM's watcher; content lives inside .exe workspace)
*.bak
*.md.bak
