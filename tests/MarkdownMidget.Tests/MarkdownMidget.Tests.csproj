<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Line-coverage measurement for the test-first house rule (>=85% on touched files):
         "dotnet test /collect:XPlat Code Coverage" writes cobertura XML per run. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MarkdownMidget\MarkdownMidget.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied: the validator's first real input should be the palette
         we actually ship, and a second copy would drift the day someone edits one. -->
    <None Include="..\..\editor-src\styles\theme-default.css"
          Link="theme-default.css" CopyToOutputDirectory="PreserveNewest" />
    <!-- The cross-engine table. Linked for the same reason: find.test.mjs reads this
         exact file, and a second copy would let the two engines drift apart the day
         someone edits one of them. -->
    <None Include="..\..\editor-src\test\fixtures\replace-templates.json"
          Link="replace-templates.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A stand-in for the app's embedded themes, so ThemeStore.Refresh can be driven
       against a real assembly rather than a mock of one. `themes/sub/nested.css`
       carries a separator deliberately: it is the resource name that would land
       outside the folder, and a test asserts that it doesn't. -->
  <ItemGroup>
    <EmbeddedResource Include="ThemeRes\apple.css"><LogicalName>themes/apple.css</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="ThemeRes\zebra.css"><LogicalName>themes/zebra.css</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="ThemeRes\sub\nested.css"><LogicalName>themes/sub/nested.css</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="ThemeRes\sample.css"><LogicalName>themes-sample.css</LogicalName></EmbeddedResource>
  </ItemGroup>

</Project>
